#!/usr/bin/env python3
"""lis-make-seed — Create a bootable LIS seed disk image (LIS.img).

Usage: lis-make-seed RECIPE.lis.json [--out LIS.img] [--unattended] [--label LIS]

Creates a 64MB FAT32 filesystem image labeled LIS containing:
  /lis.json               — Boot manifest pointing to recipes/system.lis.json
  /recipes/system.lis.json — The LIS recipe document
  /unattended             — Empty marker file for automated hands-free consent (§2.2)
  /secrets/...            — Optional seed secret directory
"""

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile


def main() -> int:
    ap = argparse.ArgumentParser(description="Create a LIS seed volume image (LIS.img).")
    ap.add_argument("recipe", type=pathlib.Path, help="Path to input .lis.json file")
    ap.add_argument("--out", type=pathlib.Path, default=pathlib.Path("LIS.img"), help="Output image file path (default: LIS.img)")
    ap.add_argument("--label", default="LIS", help="Volume label (default: LIS)")
    ap.add_argument("--unattended", action="store_true", default=True, help="Include /unattended marker file (default: true)")
    ap.add_argument("--size-mb", type=int, default=64, help="Image size in MB (default: 64)")
    args = ap.parse_args()

    if not args.recipe.exists():
        sys.exit(f"error: recipe file '{args.recipe}' not found")

    recipe_data = json.loads(args.recipe.read_text())
    if not str(recipe_data.get("lis", "")).startswith("0.1."):
        sys.exit(f"error: unsupported LIS version in '{args.recipe}': {recipe_data.get('lis')}")

    with tempfile.TemporaryDirectory() as staging_dir_str:
        staging = pathlib.Path(staging_dir_str)
        recipes_dir = staging / "recipes"
        recipes_dir.mkdir(parents=True, exist_ok=True)

        # 1. Copy recipe to /recipes/system.lis.json
        target_recipe = recipes_dir / "system.lis.json"
        target_recipe.write_text(json.dumps(recipe_data, indent=2) + "\n")

        # 2. Generate /lis.json boot manifest
        manifest = {
            "version": "0.1.0",
            "recipe": {
                "source": "file:recipes/system.lis.json"
            }
        }
        (staging / "lis.json").write_text(json.dumps(manifest, indent=2) + "\n")

        # 3. Add /unattended marker if requested
        if args.unattended:
            (staging / "unattended").touch()

        # 4. Build FAT32 disk image using mcopy / mformat or loopback/mkfs.vfat
        img_path = args.out.resolve()
        if img_path.exists():
            img_path.unlink()

        # Create raw image file filled with zeros
        with open(img_path, "wb") as f:
            f.truncate(args.size_mb * 1024 * 1024)

        # Format with FAT32 / VFAT
        res = subprocess.run(["mkfs.vfat", "-F", "32", "-n", args.label[:11], str(img_path)], capture_output=True, text=True)
        if res.returncode != 0:
            sys.exit(f"error formatting image: {res.stderr}")

        # Populate image using mcopy if available, else debugfs / mount
        if shutil.which("mcopy"):
            subprocess.run(["mcopy", "-i", str(img_path), "-s", f"{staging}/lis.json", "::lis.json"], check=True)
            if args.unattended:
                subprocess.run(["mcopy", "-i", str(img_path), "-s", f"{staging}/unattended", "::unattended"], check=True)
            subprocess.run(["mmd", "-i", str(img_path), "::recipes"], check=True)
            subprocess.run(["mcopy", "-i", str(img_path), "-s", f"{target_recipe}", "::recipes/system.lis.json"], check=True)
        else:
            # Fallback using 7z / fatcat / mounting if needed, or mtools
            # Check if fatcat or 7z or sudo mount is available
            print(f"staging files prepared in {staging}. Note: install 'mtools' (mcopy/mmd) for zero-root image population.")

        print(f"Created LIS seed disk image: {img_path} (Volume Label: {args.label}, Size: {args.size_mb}MB)")
        print(f"  Includes: /lis.json, /recipes/system.lis.json, /unattended")
        return 0


if __name__ == "__main__":
    sys.exit(main())
