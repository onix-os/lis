#!/usr/bin/env python3
"""lis-make-seed — build a LIS seed volume image (delivery.md §1).

Usage: lis-make-seed RECIPE.lis.json [--out LIS.img] [--label LIS]
                     [--no-unattended] [--secrets DIR] [--size-mb N]

Creates a FAT32 filesystem image labeled LIS containing:
  /lis.json                — boot manifest pointing at recipes/system.lis.json
  /recipes/system.lis.json — the LIS recipe document
  /unattended              — empty consent marker (delivery.md §5)
  /appliers/*.py           — the translators, so a live ISO can run one
  /secrets/…               — optional secret material referenced as seed:…

The seed carries intent and consent. It does not carry an installer: applying
the recipe is the job of a distro applier running the distro's own installer.
"""

import argparse
import json
import pathlib
import shutil
import subprocess
import sys
import tempfile


def mcopy(img: pathlib.Path, src: pathlib.Path, dest: str) -> None:
    subprocess.run(["mcopy", "-i", str(img), "-s", str(src), f"::{dest}"], check=True)


def mmd(img: pathlib.Path, path: str) -> None:
    subprocess.run(["mmd", "-i", str(img), f"::{path}"], check=True)


def main() -> int:
    ap = argparse.ArgumentParser(description="Create a LIS seed volume image.")
    ap.add_argument("recipe", type=pathlib.Path, help="path to the .lis.json document")
    ap.add_argument("--out", type=pathlib.Path, default=pathlib.Path("LIS.img"))
    ap.add_argument("--label", default="LIS", help="volume label (default: LIS)")
    ap.add_argument("--no-unattended", dest="unattended", action="store_false",
                    help="omit the /unattended consent marker, forcing a confirmation step")
    ap.add_argument("--secrets", type=pathlib.Path,
                    help="directory copied to /secrets on the seed")
    ap.add_argument("--size-mb", type=int, default=64)
    args = ap.parse_args()

    if not args.recipe.exists():
        sys.exit(f"error: recipe file '{args.recipe}' not found")
    if not shutil.which("mcopy"):
        sys.exit("error: mtools (mcopy/mmd) is required to populate the seed image")

    recipe = json.loads(args.recipe.read_text())
    if not str(recipe.get("lis", "")).startswith("0.1."):
        sys.exit(f"error: unsupported LIS version in '{args.recipe}': {recipe.get('lis')}")

    with tempfile.TemporaryDirectory() as staging_str:
        staging = pathlib.Path(staging_str)
        recipes_dir = staging / "recipes"
        recipes_dir.mkdir(parents=True)
        target_recipe = recipes_dir / "system.lis.json"
        target_recipe.write_text(json.dumps(recipe, indent=2) + "\n")

        manifest = {"lis": "0.1.0",
                    "source": {"type": "file", "path": "/recipes/system.lis.json"}}
        (staging / "lis.json").write_text(json.dumps(manifest, indent=2) + "\n")

        # delivery.md §5: the channel consent key is an *empty* marker file.
        marker = staging / "unattended"
        marker.write_text("")

        img = args.out.resolve()
        if img.exists():
            img.unlink()
        with open(img, "wb") as f:
            f.truncate(args.size_mb * 1024 * 1024)
        res = subprocess.run(["mkfs.vfat", "-F", "32", "-n", args.label[:11], str(img)],
                             capture_output=True, text=True)
        if res.returncode != 0:
            sys.exit(f"error formatting image: {res.stderr}")

        mcopy(img, staging / "lis.json", "lis.json")
        if args.unattended:
            mcopy(img, marker, "unattended")
        mmd(img, "recipes")
        mcopy(img, target_recipe, "recipes/system.lis.json")

        appliers_src = pathlib.Path(__file__).resolve().parent / "appliers"
        if appliers_src.exists():
            mmd(img, "appliers")
            for applier in sorted(appliers_src.glob("*.py")):
                mcopy(img, applier, f"appliers/{applier.name}")

        if args.secrets:
            if not args.secrets.is_dir():
                sys.exit(f"error: --secrets '{args.secrets}' is not a directory")
            mmd(img, "secrets")
            for secret in sorted(args.secrets.iterdir()):
                if secret.is_file():
                    mcopy(img, secret, f"secrets/{secret.name}")

    contents = ["/lis.json", "/recipes/system.lis.json", "/appliers/"]
    if args.unattended:
        contents.insert(1, "/unattended")
    if args.secrets:
        contents.append("/secrets/")
    print(f"Created LIS seed image: {img} (label {args.label}, {args.size_mb}MB)")
    print(f"  Contains: {', '.join(contents)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
