#!/usr/bin/env python3
"""lis-test-e2e — Standalone Automated VM Installation & Verification Engine.

Usage: lis-test-e2e --distro nixos|ubuntu|arch|fedora|suse|debian|alpine [--iso ISO_PATH] [--recipe RECIPE.lis.json]

Downloads distribution ISOs automatically to /tmp/ if not present, builds FAT32 seed volumes,
runs QEMU installer VMs with pexpect serial automation, and inspects installed disks with ANSI colored checklists.
"""

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time
import urllib.request
import pexpect

