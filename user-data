#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  timezone: UTC
  keyboard:
    layout: us
    variant: ""
  identity:
    hostname: lis-test-host
    username: fakeuser
    realname: "Test Fake User"
    password: "$6$lise2esalt$FZ.sWLZOpKWcO0Ov5XiGDzqVm0dxHB3.H1mFLg.aoFV/ZgVrxSq/bc1xkKj4PiTHxfgi9MxhH/kL.32Lu94CT1"
  ssh:
    install-server: false
    allow-pw: false
    authorized-keys: []
  storage:
    config:
      - type: disk
        id: disk-main
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        path: "/dev/vda"
        grub_device: true
      - type: partition
        id: disk-main-biosgrub
        device: disk-main
        size: 1048576
        flag: bios_grub
        wipe: superblock
        preserve: false
      - type: disk
        id: disk-second
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        path: "/dev/vdb"
        grub_device: true
      - type: partition
        id: disk-second-biosgrub
        device: disk-second
        size: 1048576
        flag: bios_grub
        wipe: superblock
        preserve: false
      - type: partition
        id: part-boot
        device: disk-main
        size: 1073741824
        wipe: superblock
        preserve: false
      - type: partition
        id: part-boot2
        device: disk-second
        size: 1073741824
        wipe: superblock
        preserve: false
      - type: partition
        id: part-praid1
        device: disk-main
        size: -1
        wipe: superblock
        preserve: false
      - type: partition
        id: part-praid2
        device: disk-second
        size: -1
        wipe: superblock
        preserve: false
      - type: raid
        id: raid-md0
        name: md0
        raidlevel: 1
        devices:
          - part-praid1
          - part-praid2
        spare_devices: []
        preserve: false
      - type: lvm_volgroup
        id: vg-vg0
        name: vg0
        devices:
          - raid-md0
        preserve: false
      - type: lvm_partition
        id: lv-vg0-swap
        name: swap
        volgroup: vg-vg0
        size: 2147483648
        preserve: false
      - type: lvm_partition
        id: lv-vg0-root
        name: root
        volgroup: vg-vg0
        size: -1
        preserve: false
      - type: format
        id: fmt-1
        volume: part-boot
        fstype: ext4
        preserve: false
      - type: format
        id: fmt-2
        volume: part-boot2
        fstype: ext4
        preserve: false
      - type: format
        id: fmt-3
        volume: lv-vg0-swap
        fstype: swap
        preserve: false
      - type: format
        id: fmt-4
        volume: lv-vg0-root
        fstype: ext4
        preserve: false
      - type: mount
        id: mnt-4
        device: fmt-4
        path: "/"
      - type: mount
        id: mnt-1
        device: fmt-1
        path: "/boot"
      - type: mount
        id: mnt-2
        device: fmt-2
        path: "/boot"
  early-commands:
    - "echo PRE_INSTALL_HOOK_PASSED > /tmp/lis-pre-install.marker"
  late-commands:
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "sed -i 's|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"console=tty0 console=ttyS0,115200n8\"|' /etc/default/grub && update-grub"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "install -d -m755 /etc/sudoers.d"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "printf '%s ALL=(ALL) NOPASSWD: ALL\\n' fakeuser > /etc/sudoers.d/99-lis-fakeuser"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "chmod 0440 /etc/sudoers.d/99-lis-fakeuser"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "usermod -u 1234 fakeuser 2>/dev/null || true"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "chown -R 1234 /home/fakeuser 2>/dev/null || true"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "{ echo '0.0 0 0.0'; echo 0; echo UTC; } > /etc/adjtime"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "grep -q '^LC_TIME=' /etc/locale.conf 2>/dev/null && sed -i 's/^LC_TIME=.*/LC_TIME=en_US.UTF-8/' /etc/locale.conf || echo LC_TIME=en_US.UTF-8 >> /etc/locale.conf"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "if grep -q '^GRUB_TIMEOUT=' /etc/default/grub 2>/dev/null; then sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' /etc/default/grub; else echo 'GRUB_TIMEOUT=5' >> /etc/default/grub; fi"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - update-grub
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "install -d -m755 /var/lib/lis && echo POST_INSTALL_HOOK_PASSED > /var/lib/lis/post_install.txt"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "if [ -e /etc/NIXOS ]; then :; elif command -v systemctl >/dev/null 2>&1; then install -d /etc/systemd/system/serial-getty@ttyS0.service.d; printf '[Service]\\nExecStart=\\nExecStart=-/sbin/agetty --autologin root --noclear %%I 115200 linux\\n' > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf; systemctl enable serial-getty@ttyS0.service; elif [ -f /etc/inittab ]; then sed -i '/ttyS0/d' /etc/inittab; echo 'ttyS0::respawn:/sbin/getty -n -l /bin/ash -L ttyS0 115200 vt100' >> /etc/inittab; fi"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "usermod -aG video fakeuser"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "chsh -s /bin/bash fakeuser"
    - - curtin
      - in-target
      - "--"
      - su
      - "-"
      - fakeuser
      - "-c"
      - "echo USER_POST_INSTALL_HOOK_PASSED > /home/fakeuser/user_hook.txt"
    - - curtin
      - in-target
      - "--"
      - sh
      - "-c"
      - "install -d -m755 /var/lib/lis && echo  | base64 -d > /var/lib/lis/system.lis.json && chmod 600 /var/lib/lis/system.lis.json"
  user-data:
    runcmd:
      - "install -d -m755 /var/lib/lis && echo FIRSTBOOT_HOOK_PASSED > /var/lib/lis/firstboot.txt"
      - "su - fakeuser -c \"echo USER_FIRSTBOOT_HOOK_PASSED > /home/fakeuser/user_firstboot.txt\""
    write_files:
      - path: "/etc/lis-test-file"
        content: RklMRVNfU0VDVElPTl9QQVNTRUQK
        encoding: b64
        permissions: "0644"
        owner: "root:root"
  packages:
    - curl
    - git
