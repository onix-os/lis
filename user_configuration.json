{
  "archinstall-language": "English",
  "hostname": "lis-test-host",
  "timezone": "UTC",
  "ntp": true,
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "bootloader": "Grub",
  "kernels": [
    "linux"
  ],
  "packages": [
    "curl",
    "git",
    "firefox",
    "neovim"
  ],
  "services": [],
  "swap": true,
  "silent": false,
  "disk_config": {
    "config_type": "manual_partitioning",
    "device_modifications": [
      {
        "device": "/dev/vda",
        "wipe": true,
        "partitions": [
          {
            "status": "create",
            "type": "primary",
            "fs_type": "fat32",
            "size": {
              "unit": "GiB",
              "value": 1
            },
            "mountpoint": "/boot",
            "flags": [
              "boot",
              "esp"
            ]
          },
          {
            "status": "create",
            "type": "primary",
            "fs_type": "linux-swap",
            "size": {
              "unit": "GiB",
              "value": 2
            },
            "mountpoint": null
          },
          {
            "status": "create",
            "type": "primary",
            "fs_type": "btrfs",
            "size": {
              "unit": "Percent",
              "value": 100
            },
            "mountpoint": "/",
            "btrfs": [
              {
                "name": "@",
                "mountpoint": "/"
              },
              {
                "name": "@home",
                "mountpoint": "/home"
              }
            ]
          }
        ]
      }
    ]
  },
  "network_config": {
    "type": "nm"
  },
  "profile_config": {
    "gfx_driver": null,
    "greeter": null,
    "profile": {
      "main": "Desktop",
      "details": [
        "Gnome"
      ]
    }
  },
  "custom-commands": [
    "echo 'PRE_INSTALL_HOOK_PASSED' > /tmp/pre_install.txt",
    "usermod -p '$6$saltsalt$fakeuserhash' fakeuser",
    "su - fakeuser -c \"echo 'USER_POST_INSTALL_HOOK_PASSED' > /tmp/user_hook.txt\"",
    "echo 'POST_INSTALL_HOOK_PASSED' > /tmp/post_install.txt",
    "echo 'FIRSTBOOT_HOOK_PASSED' > /tmp/firstboot.txt"
  ]
}
