{
  "archinstall_language": "English",
  "hostname": "lis-test-host",
  "timezone": "UTC",
  "ntp": true,
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "bootloader_config": {
    "bootloader": "Grub",
    "uki": false,
    "removable": false
  },
  "kernels": [
    "linux"
  ],
  "packages": [
    "curl",
    "git",
    "bash"
  ],
  "services": [],
  "swap": true,
  "disk_config": {
    "config_type": "pre_mounted_config",
    "mountpoint": "/mnt/lis"
  },
  "network_config": {
    "type": "nm"
  },
  "custom_commands": [
    "echo PRE_INSTALL_HOOK_PASSED > /tmp/lis-pre-install.marker",
    "usermod -c \"Test Fake User\" fakeuser",
    "chsh -s /bin/bash fakeuser",
    "su - fakeuser -c \"echo USER_POST_INSTALL_HOOK_PASSED > /home/fakeuser/user_hook.txt\"",
    "install -d -m755 /etc/sudoers.d",
    "printf '%s ALL=(ALL) NOPASSWD: ALL\\n' fakeuser > /etc/sudoers.d/99-lis-fakeuser",
    "chmod 0440 /etc/sudoers.d/99-lis-fakeuser",
    "usermod -u 1234 fakeuser 2>/dev/null || true",
    "chown -R 1234 /home/fakeuser 2>/dev/null || true",
    "{ echo '0.0 0 0.0'; echo 0; echo UTC; } > /etc/adjtime",
    "grep -q '^LC_TIME=' /etc/locale.conf 2>/dev/null && sed -i 's/^LC_TIME=.*/LC_TIME=en_US.UTF-8/' /etc/locale.conf || echo LC_TIME=en_US.UTF-8 >> /etc/locale.conf",
    "if grep -q '^GRUB_TIMEOUT=' /etc/default/grub 2>/dev/null; then sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' /etc/default/grub; else echo 'GRUB_TIMEOUT=5' >> /etc/default/grub; fi",
    "grub-mkconfig -o /boot/grub/grub.cfg",
    "install -d -m755 /var/lib/lis && echo POST_INSTALL_HOOK_PASSED > /var/lib/lis/post_install.txt",
    "if [ -e /etc/NIXOS ]; then :; elif command -v systemctl >/dev/null 2>&1; then install -d /etc/systemd/system/serial-getty@ttyS0.service.d; printf '[Service]\\nExecStart=\\nExecStart=-/sbin/agetty --autologin root --noclear %%I 115200 linux\\n' > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf; systemctl enable serial-getty@ttyS0.service; elif [ -f /etc/inittab ]; then sed -i '/ttyS0/d' /etc/inittab; echo 'ttyS0::respawn:/sbin/getty -n -l /bin/ash -L ttyS0 115200 vt100' >> /etc/inittab; fi",
    "install -d /etc",
    "echo RklMRVNfU0VDVElPTl9QQVNTRUQK | base64 -d > /etc/lis-test-file",
    "chmod 0644 /etc/lis-test-file",
    "chown root:root /etc/lis-test-file",
    "install -d -m755 /var/lib/lis /usr/local/bin",
    "echo IyEvYmluL3NoCmluc3RhbGwgLWQgLW03NTUgL3Zhci9saWIvbGlzICYmIGVjaG8gRklSU1RCT09UX0hPT0tfUEFTU0VEID4gL3Zhci9saWIvbGlzL2ZpcnN0Ym9vdC50eHQKc3UgLSBmYWtldXNlciAtYyAiZWNobyBVU0VSX0ZJUlNUQk9PVF9IT09LX1BBU1NFRCA+IC9ob21lL2Zha2V1c2VyL3VzZXJfZmlyc3Rib290LnR4dCIKdG91Y2ggL3Zhci9saWIvbGlzLy5maXJzdGJvb3QtZG9uZQo= | base64 -d > /usr/local/bin/lis-firstboot",
    "chmod 755 /usr/local/bin/lis-firstboot",
    "echo W1VuaXRdCkRlc2NyaXB0aW9uPUxJUyBmaXJzdCBib290CkFmdGVyPW11bHRpLXVzZXIudGFyZ2V0CkNvbmRpdGlvblBhdGhFeGlzdHM9IS92YXIvbGliL2xpcy8uZmlyc3Rib290LWRvbmUKCltTZXJ2aWNlXQpUeXBlPW9uZXNob3QKRXhlY1N0YXJ0PS91c3IvbG9jYWwvYmluL2xpcy1maXJzdGJvb3QKCltJbnN0YWxsXQpXYW50ZWRCeT1tdWx0aS11c2VyLnRhcmdldAo= | base64 -d > /etc/systemd/system/lis-firstboot.service",
    "systemctl enable lis-firstboot.service",
    "sed -i \"s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\\\"console=tty0 console=ttyS0,115200n8\\\"|\" /etc/default/grub",
    "grub-mkconfig -o /boot/grub/grub.cfg",
    "install -d -m755 /var/lib/lis",
    "echo  | base64 -d > /var/lib/lis/system.lis.json",
    "chmod 600 /var/lib/lis/system.lis.json",
    "passwd -l root"
  ]
}
